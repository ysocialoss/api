DATABASE_URL=postgresql://ysocial:ysocial@localhost:5432/ysocial
PORT=3100

APP_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3200
CNS_CLIENT_ID=ysocial
CNS_DISCOVERY_URL=https://api.cns-preview.de/.well-known/openid-configuration
CNS_LOGIN_URL=https://accounts.cns-preview.de/login
CNS_API_ORIGIN=https://api.cns-preview.de
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=
# Production requires HTTPS APP_ORIGIN and a persistent encryption key.
NODE_ENV=development

# GitHub OAuth app for profile connections. Register APP_ORIGIN + /api/github/callback
# as the authorization callback URL. Keep a separate OAuth app per environment.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional server-only token for a higher quota when reading public contributions.
GITHUB_PUBLIC_READ_TOKEN=

# Private Cloudflare R2 bucket created with jurisdiction "European Union (EU)".
# All four values are required together; leave empty to disable avatar uploads.
# Endpoint is always https://<account-id>.eu.r2.cloudflarestorage.com.
# Use a bucket-scoped Object Read & Write R2 API token. Never expose these to web/.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Keep public access, custom domains/CDN caching, and Local Uploads disabled.

# KLIPY GIF search key, server only. Test keys allow 100 calls/hour.
KLIPY_API_KEY=

# Web Push. Generate once with: pnpm exec web-push generate-vapid-keys --json
# Keep the private key server-side and reuse the pair across deployments.
# Set all three values to enable push. In-app notifications work without them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Example subject: https://ysocial.cc
VAPID_SUBJECT=

# Open live update streams (SSE) one API process accepts. Clients fall back to refreshing manually.
LIVE_MAX_STREAMS=2000
