# Local PostgreSQL credentials match ../compose.yaml defaults.
DATABASE_URL=postgresql://ysocial:ysocial@localhost:5432/ysocial
PORT=3100

APP_ORIGIN=http://localhost:3000
CNS_CLIENT_ID=ysocial
CNS_DISCOVERY_URL=https://api.cns.ad/.well-known/openid-configuration
CNS_LOGIN_URL=https://accounts.cns.ad/login
CNS_API_ORIGIN=https://api.cns.ad
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=
# Production requires HTTPS APP_ORIGIN and a persistent encryption key.
NODE_ENV=development
